rules_version = '2';

// Fotos de productos. Se suben ya comprimidas desde el navegador (~60 KB);
// el límite de 600 KB es para que una foto sin comprimir no pase por error.
service firebase.storage {
  match /b/{bucket}/o {
    match /productos/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 600 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /gastos/{archivo} {
      allow read, write: if request.auth != null
                   && (request.method == 'get' || request.resource.size < 600 * 1024);
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
