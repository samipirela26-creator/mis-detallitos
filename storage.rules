rules_version = '2';

// Fotos de productos. Se suben ya comprimidas desde el navegador (~60 KB);
// el límite de 600 KB es para que una foto sin comprimir no pase por error.
service firebase.storage {
  match /b/{bucket}/o {
    match /productos/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 600 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Igual que productos. Antes esto decía `allow read, write` con un truco
    // (`request.method == 'get'`) para saltarse el límite en las lecturas, y de
    // paso se saltaba la revisión del tipo de archivo: con una cuenta recién
    // registrada —que nace apagada y no puede leer nada en Firestore— se podía
    // subir aquí cualquier cosa, no solo una imagen.
    match /gastos/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 600 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
