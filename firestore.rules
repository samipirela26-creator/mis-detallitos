rules_version = '2';

// Mis Detallitos — reglas de seguridad.
//
// Principio: el EMPLEADO nunca debe poder leer costos ni ganancias. Firestore no
// puede filtrar campos, así que el empleado NO lee `productos` (que tiene
// costoUSD): lee el espejo `productos_venta`, que se escribe sin los campos
// sensibles. Ocultarlo en la interfaz no sirve de nada: con la consola del
// navegador cualquiera lee lo que el cliente descargó.

service cloud.firestore {
  match /databases/{database}/documents {

    match /negocios/{negocioId} {

      function miDoc() {
        return get(/databases/$(database)/documents/negocios/$(negocioId)/usuarios/$(request.auth.uid));
      }
      function autenticado() {
        return request.auth != null;
      }
      function miRol() {
        return autenticado() && exists(/databases/$(database)/documents/negocios/$(negocioId)/usuarios/$(request.auth.uid))
          ? miDoc().data.rol : 'ninguno';
      }
      function esDueno()    { return miRol() == 'dueno'; }
      function esEmpleado() { return miRol() == 'empleado' && miDoc().data.activo == true; }
      function delEquipo()  { return esDueno() || esEmpleado(); }
      function soyYo()      { return request.auth.uid == request.resource.data.uid; }

      allow read: if delEquipo();
      allow write: if false;

      // --- usuarios ---
      //
      // Quien recibe el link puede registrarse solo, PERO su cuenta nace
      // apagada: `rol: 'empleado'` y `activo: false`. Mientras esté apagada no
      // puede leer ni el catálogo ni nada (ver `esEmpleado()`, que exige
      // activo == true). Encenderla es un toque del dueño.
      //
      // Lo que esto impide: que alguien que consiga el link se meta a ver las
      // ventas, y que un empleado se ascienda a dueño editando su propio
      // documento.
      match /usuarios/{uid} {
        function soyEsteUsuario() { return request.auth != null && request.auth.uid == uid; }

        // El que está en espera tiene que poder leer SU propio documento, si no
        // la app no sabría que está esperando.
        allow read: if delEquipo() || soyEsteUsuario();

        allow create: if soyEsteUsuario()
          && request.resource.data.rol == 'empleado'
          && request.resource.data.activo == false
          && request.resource.data.keys().hasOnly(['nombre', 'email', 'rol', 'activo', 'creado']);

        allow update: if esDueno()
          || (soyEsteUsuario()
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['rol', 'activo', 'pinHash']));

        allow delete: if esDueno();
      }

      // --- configuración y tasas ---
      match /config/{doc} {
        allow read: if delEquipo();
        allow write: if esDueno();
      }
      match /tasas/{fecha} {
        allow read: if delEquipo();
        allow create, update: if esDueno();   // la tasa la fija el dueño
        allow delete: if false;
      }

      // --- catálogo con costos: SOLO el dueño ---
      match /productos/{id} {
        allow read, write: if esDueno();
      }

      // --- espejo sin costos: lo que ve el empleado ---
      // Lo escribe el DUEÑO desde su propia app (data/productos.js escribe
      // siempre los dos documentos en el mismo writeBatch). Así no hace falta
      // Cloud Functions y el proyecto se queda en el plan gratuito.
      // El empleado nunca escribe aquí; el stock lo ajusta el ledger.
      match /productos_venta/{id} {
        allow read: if delEquipo();
        allow create, update, delete: if esDueno();
      }

      // --- fotos de productos (van en Firestore porque Storage exige plan
      //     de pago; ~60 KB cada una, en documentos aparte para no inflar
      //     el catálogo) ---
      match /fotos/{productoId} {
        allow read: if delEquipo();
        allow write: if esDueno();
      }

      // --- ledger de inventario: append-only, nunca se edita ni se borra ---
      match /movimientos/{id} {
        allow read: if esDueno();
        allow create: if delEquipo() && soyYo();
        allow update, delete: if false;
      }

      // --- ventas: el empleado crea; anular es del dueño ---
      match /ventas/{id} {
        allow read: if esDueno() || (esEmpleado() && resource.data.uid == request.auth.uid);
        allow create: if delEquipo() && soyYo()
                      && request.resource.data.estado == 'ok';
        allow update: if esDueno();
        allow delete: if false;
      }
      match /anulaciones/{id} {        // el empleado PIDE, el dueño aprueba
        allow read: if delEquipo();
        allow create: if delEquipo() && soyYo();
        allow update: if esDueno();
        allow delete: if false;
      }

      // --- gastos ---
      match /gastos/{id} {
        allow read: if esDueno() || (esEmpleado() && resource.data.uid == request.auth.uid);
        allow create: if delEquipo() && soyYo();
        allow update, delete: if esDueno();
      }

      // --- caja / turnos: una vez cerrada, intocable ---
      match /cajas/{id} {
        allow read: if esDueno() || (esEmpleado() && resource.data.uid == request.auth.uid);
        allow create: if delEquipo() && soyYo();
        allow update: if esDueno()
          || (esEmpleado() && resource.data.uid == request.auth.uid
              && resource.data.estado == 'abierta');
        allow delete: if false;
      }

      // --- clientes y deudas ---
      match /clientes/{id} {
        allow read: if delEquipo();
        allow create, update: if delEquipo();
        allow delete: if esDueno();
      }
      match /abonos/{id} {
        allow read: if delEquipo();
        allow create: if delEquipo() && soyYo();
        allow update, delete: if esDueno();
      }

      // --- auditoría: solo el dueño la lee, nadie la modifica ---
      match /auditoria/{id} {
        allow read: if esDueno();
        allow create: if delEquipo() && soyYo();
        allow update, delete: if false;
      }

      // --- sinónimos que la app va aprendiendo ---
      match /sinonimos_pendientes/{id} {
        allow read: if delEquipo();
        allow create: if delEquipo() && soyYo();
        allow update, delete: if esDueno();
      }

      match /{documento=**} {
        allow read, write: if false;
      }
    }
  }
}
