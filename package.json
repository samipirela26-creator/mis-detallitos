{
  "name": "mis-detallitos",
  "version": "1.0.0",
  "private": true,
  "description": "Ventas, inventario y ganancias de la papelería Mis Detallitos G&M C.A",
  "type": "module",
  "scripts": {
    "test": "node --test test/",
    "emuladores": "firebase emulators:start --project mis-detallitos --only auth,firestore,hosting",
    "sembrar": "node scripts/sembrar-emulador.mjs",
    "reglas": "node --test test/reglas.test.mjs",
    "publicar": "npm run precache && firebase deploy --project mis-detallitos",
    "precache": "node scripts/revisar-precache.mjs"
  },
  "devDependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.0.0",
    "sharp": "^0.35.5"
  }
}
